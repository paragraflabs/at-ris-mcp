mente/Justiz/JJT_20260624_OGH0002_008OBA00009_26W0000_000/JJT_20260624_OGH0002_008OBA00009_26W0000_000.xml"},{"DataType":"Html","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJT_20260624_OGH0002_008OBA00009_26W0000_000/JJT_20260624_OGH0002_008OBA00009_26W0000_000.html"},{"DataType":"Rtf","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJT_20260624_OGH0002_008OBA00009_26W0000_000/JJT_20260624_OGH0002_008OBA00009_26W0000_000.rtf"},{"DataType":"Pdf","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJT_20260624_OGH0002_008OBA00009_26W0000_000/JJT_20260624_OGH0002_008OBA00009_26W0000_000.pdf"}]}}}}},{"Data":{"Metadaten":{"Technisch":{"ID":"JJR_19761110_OGH0002_0080OB00552_7600000_001","Applikation":"Justiz","Organ":"OGH","ImportTimestamp":{"@xsi:nil":"true","@xmlns:xsi":"http://www.w3.org/2001/XMLSchema-instance"}},"Allgemein":{"Veroeffentlicht":"1997-06-15","Geaendert":"2026-07-09","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJR_19761110_OGH0002_0080OB00552_7600000_001"},"Judikatur":{"Dokumenttyp":"Rechtssatz","Geschaeftszahl":{"item":"8Ob552/76 (8Ob553/76); 3Ob667/81; 3Ob616/82; 6Ob637/94; 7Ob183/08z; 4Ob44/12t; 10Ob12/14h; 8Ob117/14k; 3Ob67/15x; 9Ob32/16w; 3Ob80/17m; 10Ob81/18m; 5Ob191/20d; 3Ob73/26w"},"Normen":{"item":"ABGB §1170"},"Entscheidungsdatum":"2026-06-23","EuropeanCaseLawIdentifier":"ECLI:AT:OGH0002:1976:RS0021979","Justiz":{"Rechtsgebiete":{"item":"Zivilrecht"},"Gericht":"OGH","Rechtssatznummern":{"item":"RS0021979"},"Entscheidungstexte":{"item":[{"Geschaeftszahl":"8 Ob 552/76","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"1976-11-10","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_19761110_OGH0002_0080OB00552_7600000_000"},{"Geschaeftszahl":"3 Ob 667/81","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"1982-03-24","Anmerkung":"Vgl auch; Beisatz: Von einem in mehreren Abteilungen zu verrichtenden Werk ist im Zweifel vor allem dann auszugehen, wenn der Unternehmer eine Mehrheit von einander unabhängigen Werken herzustellen hat. (T1)"},{"Geschaeftszahl":"3 Ob 616/82","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"1982-11-10"},{"Geschaeftszahl":"6 Ob 637/94","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"1994-11-24","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_19941124_OGH0002_0060OB00637_9400000_000"},{"Geschaeftszahl":"7 Ob 183/08z","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2008-09-24","Anmerkung":"Auch; Beis wie T1","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20080924_OGH0002_0070OB00183_08Z0000_000"},{"Geschaeftszahl":"4 Ob 44/12t","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2012-04-17","Anmerkung":"Auch; Beis wie T1; Beisatz: Hier: Detektivleistungen (T2)","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20120417_OGH0002_0040OB00044_12T0000_000"},{"Geschaeftszahl":"10 Ob 12/14h","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2014-03-25","Anmerkung":"Auch; Beisatz: Je nach Baufortschritt zu erstellende Rechnungen begründen noch keine „gewissen Abteilungen“ iSd § 1170 S. 2 ABGB und unterliegen daher auch keiner gesonderten Verjährung. Sie können daher auch noch im Rahmen der Abrechnung des (nicht verjährten) Gesamtwerklohns geltend gemacht werden. (T3)","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20140325_OGH0002_0100OB00012_14H0000_000"},{"Geschaeftszahl":"8 Ob 117/14k","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2014-11-25","Anmerkung":"Vgl auch; Beisatz: Zusatzleistungen, die gesondert zu honorieren sind, aber auf Basis oder zumindest im Rahmen des ursprünglichen Werkvertrags erbracht werden, sind nicht selbstständige Teilleistungen oder selbstständige (besser: eigenständige) Werkverträge, sondern Teil der ursprünglichen einheitlichen Gesamtleistung. (T4)<br/>Beisatz: Die Frage des Bestehens einer besonders engen Nahebeziehung im Sinn einer engen inhaltlichen Verknüpfung zwischen dem ursprünglich vereinbarten Werk und später vereinbarten (beauftragten bzw abgerufenen) Zusatzleistungen bestimmt sich nach der Vertragsauslegung, die typisch den Einzelfall betrifft und im Allgemeinen keine erhebliche Rechtsfrage begründet. (T5)<br/>","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20141125_OGH0002_0080OB00117_14K0000_000"},{"Geschaeftszahl":"3 Ob 67/15x","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2015-06-17","Anmerkung":"Auch; Beisatz: Hier Lieferung und Montage einerseits von Fenstern und Türen und andererseits von Außenraffstores. (T6)","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20150617_OGH0002_0030OB00067_15X0000_000"},{"Geschaeftszahl":"9 Ob 32/16w","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2016-07-26","Anmerkung":"Vgl auch; Beis ähnlich wie T3; Beisatz: Bei der Verrechnung einzelner Teilleistungen nach prozentuellem Baufortschritt handelt es sich nicht um die Verrechnung einzelner voneinander unabhängiger Leistungen, sondern um die Verrechnung aufeinander aufbauender Teilleistungen im Rahmen des gesamten Bauprojekts. Bei derartigen Abschlagszahlungen, die nur ein Akonto bzw einen Vorschuss auf das Schlussrechnungsentgelt darstellen, beginnt die Verjährung der Forderung, die in der Abschlagsrechnung geltend gemacht wird, erst mit der Fälligkeit des Werklohns bzw der Schlussrechnung und nicht schon ab Fälligkeit der Abschlagsrechnung. (T7)<br/>Beisatz: Wann in diesem Sinn von einem Werk „in gewissen Abteilungen“ auszugehen ist, entscheiden der Parteiwille und die Übung des redlichen Verkehrs. (T8)","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20160726_OGH0002_0090OB00032_16W0000_000"},{"Geschaeftszahl":"3 Ob 80/17m","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2017-06-07","Anmerkung":"Beis wie T1","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20170607_OGH0002_0030OB00080_17M0000_000"},{"Geschaeftszahl":"10 Ob 81/18m","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2019-03-26","Anmerkung":"Vgl; Beis wie T8","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20190326_OGH0002_0100OB00081_18M0000_000"},{"Geschaeftszahl":"5 Ob 191/20d","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsdatum":"2020-11-30","Anmerkung":"Vgl; Beis wie T4","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20201130_OGH0002_0050OB00191_20D0000_000"},{"Geschaeftszahl":"3 Ob 73/26w","Dokumenttyp":"Text","Gericht":"OGH","Entscheidungsart":"Zurückweisung mangels erheblicher Rechtsfrage","Entscheidungsdatum":"2026-06-23","Anmerkung":"Beisatz wie T1","DokumentUrl":"https://www.ris.bka.gv.at/Dokument.wxe?Abfrage=Justiz&Dokumentnummer=JJT_20260623_OGH0002_0030OB00073_26W0000_000"}]}}}},"Dokumentliste":{"ContentReference":{"ContentType":"MainDocument","Name":"Hauptdokument","Urls":{"ContentUrl":[{"DataType":"Xml","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJR_19761110_OGH0002_0080OB00552_7600000_001/JJR_19761110_OGH0002_0080OB00552_7600000_001.xml"},{"DataType":"Html","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJR_19761110_OGH0002_0080OB00552_7600000_001/JJR_19761110_OGH0002_0080OB00552_7600000_001.html"},{"DataType":"Rtf","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJR_19761110_OGH0002_0080OB00552_7600000_001/JJR_19761110_OGH0002_0080OB00552_7600000_001.rtf"},{"DataType":"Pdf","Url":"https://www.ris.bka.gv.at/Dokumente/Justiz/JJR_19761110_OGH0002_0080OB00552_7600000_001/JJR_19761110_OGH0002_0080OB00552_7600000_001.pdf"}]}}}}}]}}}